{
  "name": "effluz-forms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:browser": "playwright test",
    "worker": "tsx src/app/worker.ts",
    "db:migrate": "tsx src/app/cli/migrate.ts",
    "sessions:revoke": "tsx src/app/cli/revoke-sessions.ts",
    "db:up": "docker compose -f compose.dev.yml up -d --wait",
    "db:down": "docker compose -f compose.dev.yml down"
  },
  "dependencies": {
    "file-type": "^21.3.4",
    "libheif-js": "^1.23.5",
    "next": "16.4.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "re2js": "^2.8.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.34.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jose": "^6.2.12",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@12.10.1"
}
