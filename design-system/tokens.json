{
  "$schema": "tokens.v1",
  "brand": {
    "ink": "#1A1423",
    "plum": "#372549",
    "berry": "#6C344E",
    "mauve": "#774C60",
    "rose": "#B75D69",
    "peach": "#EACDC2",
    "blush": "#FFF3EF",
    "lilac": "#F4F3FA",
    "lavender": "#EFF0F5",
    "white": "#FFFFFF",
    "errorFg": "#9B1C1C",
    "errorBg": "#FBECEC",
    "warningFg": "#7A4B00",
    "warningBg": "#FFF4D6",
    "successFg": "#1F6B4A",
    "successBg": "#E6F2EC"
  },
  "color": {
    "text": {
      "default": { "value": "{brand.ink}", "onSurfaces": ["surface.page.public", "surface.page.staff", "surface.card"], "minContrast": 16.3 },
      "muted": { "value": "{brand.mauve}", "onSurfaces": ["surface.page.public", "surface.page.staff", "surface.card"], "minContrast": 6.2 },
      "secondary": { "value": "{brand.berry}", "onSurfaces": ["surface.card"], "minContrast": 9.4 },
      "inverse": { "value": "{brand.blush}", "onSurfaces": ["surface.inverse"], "minContrast": 12.7 },
      "link": { "value": "{brand.plum}", "hover": "{brand.rose}", "note": "rose hover is decorative; underline persists" },
      "error": { "value": "{brand.errorFg}", "onSurfaces": ["surface.card", "surface.error"], "minContrast": 6.6 },
      "warning": { "value": "{brand.warningFg}", "onSurfaces": ["surface.card", "surface.warning"], "minContrast": 6.8 },
      "success": { "value": "{brand.successFg}", "onSurfaces": ["surface.card", "surface.success"], "minContrast": 6.2 }
    },
    "surface": {
      "page": { "public": "{brand.blush}", "staff": "{brand.lilac}" },
      "card": "{brand.white}",
      "inverse": "{brand.plum}",
      "subtle": "{brand.lavender}",
      "selected": "{brand.peach}",
      "error": "{brand.errorBg}",
      "warning": "{brand.warningBg}",
      "success": "{brand.successBg}"
    },
    "border": {
      "default": { "value": "{brand.lavender}", "note": "cards, dividers; not a 3:1 UI boundary, decorative" },
      "input": { "value": "{brand.mauve}", "onSurfaces": ["surface.card"], "minContrast": 7.0 },
      "inputFocus": "{brand.plum}",
      "error": "{brand.errorFg}"
    },
    "action": {
      "primary": { "bg": "{brand.plum}", "fg": "{brand.blush}", "hoverBg": "{brand.berry}", "contrast": 13.8 },
      "secondary": { "bg": "{brand.white}", "fg": "{brand.plum}", "border": "{brand.plum}", "hoverBg": "{brand.lavender}" },
      "tertiary": { "fg": "{brand.plum}", "hoverFg": "{brand.berry}" },
      "destructive": { "bg": "{brand.errorFg}", "fg": "{brand.white}", "contrast": 7.4 },
      "disabledBg": "{brand.lavender}",
      "disabledFg": "{brand.mauve}"
    },
    "focus": {
      "ring": { "value": "{brand.rose}", "onSurfaces": ["surface.page.public", "surface.card", "surface.page.staff"], "minContrast": 3.9, "note": "UI contrast, 3:1 required" },
      "ringOnInverse": "{brand.blush}"
    },
    "accent": { "value": "{brand.rose}", "note": "at most once per view; never body text; never white-label buttons" }
  },
  "font": {
    "family": { "sans": "Poppins, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "size": {
      "public": { "display": 28, "displayLg": 32, "heading": 22, "label": 16, "body": 17, "small": 15, "button": 16, "inputMin": 16, "wordmark": 24 },
      "staff": { "display": 24, "heading": 18, "label": 14, "body": 15, "small": 13, "button": 14 }
    },
    "lineHeight": { "tight": 1.2, "heading": 1.3, "label": 1.4, "body": 1.6, "small": 1.5, "button": 1 },
    "features": { "tabularNumbers": "tnum" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
  "size": {
    "touchTarget": 44,
    "pointerTargetMin": 32,
    "contentWidthPublic": 640,
    "drawerWidth": 720,
    "outlineWidth": 280,
    "previewWidth": 420,
    "iconDefault": 24,
    "iconSmall": 20,
    "iconInline": 16,
    "controlHeight": 48,
    "textareaMin": 144,
    "datePart": 88,
    "datePartYear": 112,
    "thumbnail": 56,
    "buttonMinWidth": 160,
    "spinner": 16,
    "photoTile": { "value": 160, "unit": "px", "description": "Staff photo grid tile; thumbnails are generated at 2x" }
  },
  "radius": { "sm": 8, "md": 12, "lg": 16, "full": 9999 },
  "border": { "width": { "default": 1, "focus": 2 } },
  "shadow": { "floating": "0 8px 24px rgba(55, 37, 73, 0.16)" },
  "motion": {
    "duration": { "fast": 120, "medium": 160, "slow": 200, "spinner": 800 },
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "instant, progress bar steps"
  },
  "breakpoint": { "sm": 480, "md": 768, "lg": 1024, "xl": 1280 },
  "z": { "base": 0, "sticky": 10, "drawer": 20, "dialog": 30, "toast": 40 }
}
