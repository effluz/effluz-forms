# Copy to .env for local development. Placeholder values only; real values
# live in the server's .env and in local files that .gitignore excludes.
# See specs/architecture.md, "Configuration and secrets".

# Runtime mode: development, test or production. Production requires https.
NODE_ENV=development

# Which process this is: "app" (web) or "worker" (background jobs).
SERVICE=app

# Build or release identifier shown in logs and health output. Default: dev.
APP_VERSION=dev

# Public origin of the app, used for sign-in callbacks and links in email.
# Scheme, host and optional port only: no path, query or fragment (a trailing
# slash is fine and dropped). Must be https in production.
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL connection string. Matches compose.dev.yml.
DATABASE_URL=postgres://effluz:effluz@localhost:5432/effluz

# Admin connection used only by the integration test setup to create
# throwaway databases. Never used by the app.
TEST_DATABASE_ADMIN_URL=postgres://effluz:effluz@localhost:5432/postgres

# Minimum log level: debug, info, warn or error.
LOG_LEVEL=info

# Local disk directory where uploads are staged before durable storage.
STAGING_DIR=./data/staging

# The one configuration value shown to the public, in the privacy footer and
# the consent template.
PRIVACY_CONTACT_EMAIL=privacy@example.com

# Name of the admin session cookie. Default: effluz_admin_session.
SESSION_COOKIE_NAME=effluz_admin_session

# Google OAuth client id for admin sign-in (Google Cloud project console).
GOOGLE_CLIENT_ID=replace-with-google-client-id

# Google OAuth client secret. Keep it out of the repository and CI.
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Only accounts in this Google Workspace domain may sign in.
GOOGLE_ALLOWED_HOSTED_DOMAIN=effluz.com

# OpenID Connect issuer. Change only to point tests at a fake provider.
# Must be https in production.
GOOGLE_ISSUER=https://accounts.google.com

# Jobs the worker runs in parallel, 1 to 32. Default: 4.
WORKER_CONCURRENCY=4

# Milliseconds between polls of the job outbox, at least 100. Default: 1000.
WORKER_POLL_INTERVAL_MS=1000

# Seconds a worker holds a job before another may retry it, at least 30.
# Each job times out 15 seconds before the lease expires. Default: 90.
WORKER_LEASE_SECONDS=90

# Extra email domains, besides the Workspace domain above, that form
# notifications may be sent to. Comma-separated, for example
# partner.example,other.example. Each entry must be a bare domain name; a
# malformed entry stops start-up. Optional; default: none.
NOTIFICATION_ALLOWED_DOMAINS=
